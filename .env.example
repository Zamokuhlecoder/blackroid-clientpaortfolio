# Client Portal Configuration (Standalone - No External Dependencies)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Your Company Name
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_PHONE=+1234567890
NEXT_PUBLIC_PHONE_DISPLAY=+1 (234) 567-890

# Optional Social Links (leave empty to disable)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/[database-name]"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="your-secret-key-here-use-openssl-rand-hex-32"

